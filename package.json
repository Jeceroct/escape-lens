{
  "name": "escape-lens",
  "displayName": "Escape Lens",
  "description": "Inline badges that reveal the real characters behind escape sequences — \\n, \\u003e, &lt;, %3C and more.",
  "version": "0.2.0",
  "publisher": "HDstar",
  "license": "MIT",
  "repository": "https://github.com/Jeceroct/escape-lens",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "escape-lens.toggle",
        "title": "Toggle",
        "category": "Escape Lens"
      },
      {
        "command": "escape-lens.replace.decode",
        "title": "Decoded character  &lt; → <"
      },
      {
        "command": "escape-lens.replace.backslash",
        "title": "Backslash  \\n, \\x3c, \\u4e2d, \\u{1F600}"
      },
      {
        "command": "escape-lens.replace.unicode",
        "title": "Unicode  \\u003c, \\ud83d\\ude00"
      },
      {
        "command": "escape-lens.replace.htmlNamed",
        "title": "HTML named entity  &lt;"
      },
      {
        "command": "escape-lens.replace.htmlDecimal",
        "title": "HTML decimal  &#60;"
      },
      {
        "command": "escape-lens.replace.htmlHex",
        "title": "HTML hex  &#x3c;"
      },
      {
        "command": "escape-lens.replace.url",
        "title": "URL percent-encoding  %3C, %E4%B8%AD"
      }
    ],
    "submenus": [
      {
        "id": "escape-lens.replace",
        "label": "Escape Lens: change to ..."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "escape-lens.replace",
          "group": "escape-lens",
          "when": "editorHasSelection"
        }
      ],
      "escape-lens.replace": [
        {
          "command": "escape-lens.replace.decode",
          "group": "1_decode",
          "when": "escapeLens.selectionIsEscape"
        },
        { "command": "escape-lens.replace.backslash", "group": "2_escape@1" },
        { "command": "escape-lens.replace.unicode", "group": "2_escape@2" },
        { "command": "escape-lens.replace.htmlNamed", "group": "2_escape@3" },
        { "command": "escape-lens.replace.htmlDecimal", "group": "2_escape@4" },
        { "command": "escape-lens.replace.htmlHex", "group": "2_escape@5" },
        { "command": "escape-lens.replace.url", "group": "2_escape@6" }
      ],
      "commandPalette": [
        { "command": "escape-lens.replace.decode", "when": "false" },
        { "command": "escape-lens.replace.backslash", "when": "false" },
        { "command": "escape-lens.replace.unicode", "when": "false" },
        { "command": "escape-lens.replace.htmlNamed", "when": "false" },
        { "command": "escape-lens.replace.htmlDecimal", "when": "false" },
        { "command": "escape-lens.replace.htmlHex", "when": "false" },
        { "command": "escape-lens.replace.url", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Escape Lens",
      "properties": {
        "escapeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch: show badges with the real characters next to escape sequences"
        },
        "escapeLens.backslash": {
          "type": "boolean",
          "default": true,
          "description": "Detect backslash escapes (\\n, \\t, \\u003e, \\x41, …)"
        },
        "escapeLens.htmlEntities": {
          "type": "boolean",
          "default": true,
          "description": "Detect HTML entities (&lt;, &#62;, &#x3e;, …)"
        },
        "escapeLens.urlEncoding": {
          "type": "boolean",
          "default": true,
          "description": "Detect URL percent-encoding (%3C, %E4%B8%AD, …)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild --bundle scripts/smoke.ts --platform=node --outfile=dist/smoke.js && node dist/smoke.js",
    "test": "npm run build && esbuild --bundle src/test/suite.ts --platform=node --format=cjs --external:vscode --outfile=dist/test-suite.js && node scripts/run-tests.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
